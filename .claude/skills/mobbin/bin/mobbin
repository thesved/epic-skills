#!/usr/bin/env python3
"""mobbin - Mobbin's official MCP server (https://api.mobbin.com/mcp) as a plain CLI.

No MCP client, no npm. Pure Python 3 stdlib speaking JSON-RPC over HTTP.
Schema-agnostic on purpose: `tools` shows what the server exposes right now and
`call` passes any tool + args through verbatim, so server-side changes need no
CLI changes.

Config:  ~/.mobbin/mcp_session.json   (OAuth token, auto-refreshed)
Override config dir with MOBBIN_HOME.
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

MCP_URL = "https://api.mobbin.com/mcp"
MCP_PROTOCOL = "2025-06-18"
MCP_AUTH = "https://ujasntkfphywizsdaapi.supabase.co/auth/v1"
MCP_META = "https://api.mobbin.com/.well-known/oauth-protected-resource/mcp"
REDIRECT_PORT = 8976
REFRESH_BUFFER = 300  # refresh this many seconds before expiry
UA = "mobbin-cli/2.0"

HOME = os.environ.get("MOBBIN_HOME") or os.path.expanduser("~/.mobbin")
TOKEN_FILE = os.path.join(HOME, "mcp_session.json")


# ---------------------------------------------------------------------------
# small helpers
# ---------------------------------------------------------------------------
def die(msg, code=1):
    sys.stderr.write("mobbin: " + msg.rstrip() + "\n")
    sys.exit(code)


def info(msg):
    sys.stderr.write(msg.rstrip() + "\n")


def ensure_home():
    os.makedirs(HOME, exist_ok=True)


def http(url, method="GET", headers=None, body=None, timeout=120):
    """Return (status, headers, text). Never raises on HTTP error status."""
    h = {"User-Agent": UA, "Accept": "*/*"}
    if headers:
        h.update(headers)
    data = body.encode() if isinstance(body, str) else body
    req = urllib.request.Request(url, data=data, headers=h, method=method)
    try:
        resp = urllib.request.urlopen(req, timeout=timeout)
        raw = resp.read()
        status = resp.getcode()
        rhead = dict(resp.headers)
    except urllib.error.HTTPError as e:
        raw = e.read()
        status = e.code
        rhead = dict(e.headers)
    return status, rhead, raw.decode("utf-8", "replace")


# ---------------------------------------------------------------------------
# OAuth 2.1 (code + PKCE) against Mobbin's Supabase auth server
# ---------------------------------------------------------------------------
def token_load():
    try:
        with open(TOKEN_FILE) as f:
            return json.load(f)
    except OSError:
        return None


def token_save(tok):
    ensure_home()
    tmp = TOKEN_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(tok, f)
    os.replace(tmp, TOKEN_FILE)
    try:
        os.chmod(TOKEN_FILE, 0o600)
    except OSError:
        pass


def register_client(redirect_uri):
    status, _, text = http(
        MCP_AUTH + "/oauth/clients/register", method="POST",
        headers={"Content-Type": "application/json"},
        body=json.dumps({
            "client_name": "mobbin-cli",
            "redirect_uris": [redirect_uri],
            "grant_types": ["authorization_code", "refresh_token"],
            "response_types": ["code"],
            "token_endpoint_auth_method": "none",
            "scope": "openid",
        }))
    if status not in (200, 201):
        die("OAuth client registration failed (%d): %s" % (status, text[:200]))
    return json.loads(text)["client_id"]


def token_request(form):
    status, _, text = http(
        MCP_AUTH + "/oauth/token", method="POST",
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        body=urllib.parse.urlencode(form))
    return status, text


def bearer():
    """Return a valid access token, refreshing via the stored refresh token."""
    t = token_load()
    if not t:
        die("not logged in. Run `mobbin login` (one-time browser approval).")
    if time.time() >= t.get("expires_at", 0) - REFRESH_BUFFER:
        if not t.get("refresh_token"):
            die("token expired, no refresh token. Run `mobbin login`.")
        status, text = token_request({
            "grant_type": "refresh_token",
            "refresh_token": t["refresh_token"],
            "client_id": t["client_id"],
        })
        if status != 200:
            die("token refresh failed (%d): %s\nRun `mobbin login`." % (status, text[:200]))
        new = json.loads(text)
        new["client_id"] = t["client_id"]
        new.setdefault("refresh_token", t["refresh_token"])
        new["expires_at"] = time.time() + new.get("expires_in", 3600)
        token_save(new)
        t = new
    return t["access_token"]


def cmd_login(args):
    """One-time OAuth approval. The MCP rejects mobbin.com web-session JWTs;
    it only accepts tokens minted by this flow."""
    import hashlib
    import http.server
    import subprocess
    ensure_home()
    redirect_uri = "http://localhost:%d/callback" % args.port
    client_id = register_client(redirect_uri)
    verifier = base64.urlsafe_b64encode(os.urandom(32)).rstrip(b"=").decode()
    challenge = base64.urlsafe_b64encode(
        hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = base64.urlsafe_b64encode(os.urandom(16)).rstrip(b"=").decode()
    auth_url = MCP_AUTH + "/oauth/authorize?" + urllib.parse.urlencode({
        "response_type": "code", "client_id": client_id,
        "redirect_uri": redirect_uri, "scope": "openid", "state": state,
        "code_challenge": challenge, "code_challenge_method": "S256",
        "resource": MCP_URL,
    })

    result = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if "code" in qs or "error" in qs:
                result["code"] = (qs.get("code") or [None])[0]
                result["state"] = (qs.get("state") or [None])[0]
                result["error"] = (qs.get("error") or [None])[0]
                result["error_description"] = (qs.get("error_description") or [None])[0]
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(b"<h3>mobbin login: done. Close this tab.</h3>")

        def log_message(self, *a):
            pass

    try:
        srv = http.server.HTTPServer(("127.0.0.1", args.port), Handler)
    except OSError as e:
        die("cannot listen on localhost:%d (%s). Pass --port to use another." % (args.port, e))
    srv.timeout = 240

    opened = False
    cdp = os.path.expanduser("~/.claude/skills/chrome/cdp.py")
    if not args.no_open and os.path.exists(cdp):
        try:  # prefer the CDP Chrome; that's where the mobbin login usually lives
            subprocess.check_output(
                ["python3", cdp, "Page.navigate", json.dumps({"url": auth_url})],
                timeout=20, stderr=subprocess.DEVNULL)
            opened = True
            info("opened the approval page in the CDP Chrome window.")
        except Exception:
            pass
    if not args.no_open and not opened and sys.platform == "darwin":
        try:
            subprocess.check_call(["open", auth_url])
            opened = True
            info("opened the approval page in your default browser.")
        except Exception:
            pass
    if not opened:
        info("open this URL in a browser where you are logged into mobbin.com:\n\n  %s\n" % auth_url)
    info("waiting for the OAuth callback on localhost:%d (240s timeout) ..." % args.port)

    deadline = time.time() + 240
    while "code" not in result and "error" not in result and time.time() < deadline:
        srv.handle_request()  # returns after one request or srv.timeout
    srv.server_close()

    if result.get("error"):
        die("authorization failed: %s (%s)" % (result["error"], result.get("error_description")))
    if not result.get("code"):
        die("no callback received. Re-run `mobbin login` and approve in the browser.")
    if result.get("state") != state:
        die("state mismatch in OAuth callback; aborting.")

    status, text = token_request({
        "grant_type": "authorization_code", "code": result["code"],
        "redirect_uri": redirect_uri, "client_id": client_id,
        "code_verifier": verifier, "resource": MCP_URL,
    })
    if status != 200:
        die("token exchange failed (%d): %s" % (status, text[:300]))
    tok = json.loads(text)
    tok["client_id"] = client_id
    tok["expires_at"] = time.time() + tok.get("expires_in", 3600)
    token_save(tok)
    info("login OK. token -> %s" % TOKEN_FILE)
    return 0


# ---------------------------------------------------------------------------
# JSON-RPC over Streamable HTTP
# ---------------------------------------------------------------------------
def sse_extract(text):
    """Pull JSON-RPC messages out of an SSE stream body; return the last
    message carrying a result/error (responses may interleave notifications)."""
    msgs = []
    for line in text.splitlines():
        if line.startswith("data:"):
            payload = line[len("data:"):].strip()
            if not payload:
                continue
            try:
                msgs.append(json.loads(payload))
            except json.JSONDecodeError:
                continue
    for m in reversed(msgs):
        if isinstance(m, dict) and ("result" in m or "error" in m):
            return m
    return msgs[-1] if msgs else None


def rpc(body, tok, session_id=None):
    """POST one JSON-RPC message; decode JSON or SSE; return (message, headers)."""
    h = {
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
        "Authorization": "Bearer " + tok,
        "MCP-Protocol-Version": MCP_PROTOCOL,
    }
    if session_id:
        h["Mcp-Session-Id"] = session_id
    status, headers, text = http(MCP_URL, method="POST", headers=h,
                                 body=json.dumps(body))
    if status == 401:
        die("MCP returned 401 (token rejected): %s\n"
            "Run `mobbin login` to (re)authorize." % text[:200])
    if status >= 400:
        die("MCP HTTP %d: %s" % (status, text[:300]))
    if not text.strip():
        return None, headers  # notifications get 202 + empty body
    ctype = ""
    for k, v in headers.items():
        if k.lower() == "content-type":
            ctype = v
    if "text/event-stream" in ctype:
        msg = sse_extract(text)
    else:
        try:
            msg = json.loads(text)
        except json.JSONDecodeError:
            die("MCP returned non-JSON (%s): %s" % (ctype, text[:200]))
    if isinstance(msg, dict) and msg.get("error"):
        die("MCP error %s: %s" % (msg["error"].get("code"),
                                  msg["error"].get("message")))
    return msg, headers


def connect():
    """initialize + initialized handshake. Returns (token, session_id, server_info).
    Stateless per CLI invocation: the server's tool list is discovered live,
    so server-side changes (new/renamed tools, changed schemas) flow through."""
    tok = bearer()
    init = {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {
        "protocolVersion": MCP_PROTOCOL,
        "capabilities": {},
        "clientInfo": {"name": "mobbin-cli", "version": "2.0"},
    }}
    msg, headers = rpc(init, tok)
    session_id = None
    for k, v in headers.items():
        if k.lower() == "mcp-session-id":
            session_id = v
    rpc({"jsonrpc": "2.0", "method": "notifications/initialized"}, tok, session_id)
    return tok, session_id, (msg or {}).get("result", {})


def content_out(result, out_dir):
    """Post-process a tools/call result: save inline base64 images to files
    (or elide them), keep everything else verbatim."""
    saved = []
    content = result.get("content") if isinstance(result, dict) else None
    if not isinstance(content, list):
        return result, saved
    n = 0
    for item in content:
        if not (isinstance(item, dict) and item.get("type") == "image"
                and item.get("data")):
            continue
        n += 1
        if out_dir:
            mime = item.get("mimeType", "image/webp")
            ext = mime.split("/")[-1].split("+")[0] or "webp"
            fname = "mcp-%02d.%s" % (n, ext)
            dest = os.path.join(out_dir, fname)
            os.makedirs(out_dir, exist_ok=True)
            with open(dest, "wb") as f:
                f.write(base64.b64decode(item["data"]))
            item["data"] = None
            item["file"] = fname
            saved.append(dest)
        else:
            size = len(item["data"])
            item["data"] = "<base64 %d chars omitted; pass --out DIR to save>" % size
    return result, saved


BYTESCALE = "https://bytescale.mobbin.com/FW25bBB/image/mobbin.com/prod/content/app_screens"
SCREEN_RE = re.compile(r"content/app_screens/([0-9a-f-]{36})\.(?:png|webp|jpe?g)")


def hires_fetch(mobbin_url, dest, width=1440):
    """MCP previews are ~300px. The public screen page leaks the raw Bytescale
    asset id in its og:image tag; the render endpoint serves native resolution
    (~1125x2436) with tunable params, no auth. Returns bytes written or raises."""
    status, _, html = http(mobbin_url, timeout=30)
    if status != 200:
        raise RuntimeError("screen page %s -> %d" % (mobbin_url, status))
    m = SCREEN_RE.search(html)
    if not m:
        raise RuntimeError("no app_screens asset id in %s (page format changed?)" % mobbin_url)
    url = "%s/%s.png?f=webp&w=%d&q=85&fit=shrink-cover" % (BYTESCALE, m.group(1), width)
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    data = urllib.request.urlopen(req, timeout=60).read()
    with open(dest, "wb") as f:
        f.write(data)
    return len(data)


def hires_all(result, out_dir, width):
    """Best-effort full-res companion downloads for a tools/call result.
    Soft-coupled to structuredContent.screens[].mobbin_url; skips quietly
    per-item if the shape drifts (the MCP contract stays schema-agnostic)."""
    screens = (result.get("structuredContent") or {}).get("screens") \
        or (result.get("structuredContent") or {}).get("flows") or []
    saved = []
    n = 0
    for s in screens:
        urls = [s.get("mobbin_url")] if s.get("mobbin_url") else \
               [sc.get("mobbin_url") for sc in (s.get("screens") or []) if isinstance(sc, dict)]
        for u in urls:
            if not u:
                continue
            n += 1
            dest = os.path.join(out_dir, "hires-%02d.webp" % n)
            try:
                hires_fetch(u, dest, width)
                saved.append(dest)
            except Exception as e:
                info("hires %s failed: %s" % (u, e))
    return saved


# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------
def cmd_doctor(args):
    ok = True
    info("config dir: " + HOME)
    status, _, text = http(MCP_META, timeout=15)
    up = status == 200 and "supabase.co" in text
    info("endpoint: %s (oauth-protected-resource -> %d)" % ("OK" if up else "FAIL", status))
    ok = ok and up
    t = token_load()
    if not t:
        info("auth: NOT LOGGED IN -> run `mobbin login`.")
        return 1
    left = int(t.get("expires_at", 0) - time.time())
    tok, sid, server = connect()
    msg, _ = rpc({"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}}, tok, sid)
    tools = (msg.get("result") or {}).get("tools", [])
    info("auth: OK (token valid ~%dm, auto-refresh on)" % (max(left, 0) // 60))
    info("server: %s %s, %d tool(s): %s" % (
        (server.get("serverInfo") or {}).get("name", "?"),
        (server.get("serverInfo") or {}).get("version", "?"),
        len(tools), ", ".join(t.get("name", "?") for t in tools)))
    return 0 if ok and tools else 1


def cmd_tools(args):
    tok, sid, server = connect()
    msg, _ = rpc({"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}}, tok, sid)
    tools = (msg.get("result") or {}).get("tools", [])
    if args.full:
        print(json.dumps({"server": server.get("serverInfo"), "tools": tools}, indent=2))
    else:
        out = [{"name": t.get("name"),
                "description": (t.get("description") or "").split("\n")[0][:160],
                "args": sorted((t.get("inputSchema") or {}).get("properties", {}).keys()),
                "required": (t.get("inputSchema") or {}).get("required", [])}
               for t in tools]
        print(json.dumps({"server": server.get("serverInfo"),
                          "count": len(out), "tools": out}, indent=2))
    return 0


def cmd_call(args):
    try:
        tool_args = json.loads(args.args) if args.args else {}
    except json.JSONDecodeError as e:
        die("--args is not valid JSON: %s" % e)
    for kv in args.set or []:
        if "=" not in kv:
            die("--set expects key=value, got %r" % kv)
        k, v = kv.split("=", 1)
        try:
            tool_args[k] = json.loads(v)  # numbers/bools/arrays pass through
        except json.JSONDecodeError:
            tool_args[k] = v
    tok, sid, _ = connect()
    msg, _ = rpc({"jsonrpc": "2.0", "id": 2, "method": "tools/call",
                  "params": {"name": args.tool, "arguments": tool_args}}, tok, sid)
    result = (msg or {}).get("result", {})
    result, saved = content_out(result, args.out)
    if saved:
        info("saved %d image(s) -> %s" % (len(saved), args.out))
    if args.out and not args.lowres:
        hs = hires_all(result, args.out, args.width)
        info("hires: %d full-res image(s) -> %s" % (len(hs), args.out))
    print(json.dumps(result, indent=2))
    return 0 if not result.get("isError") else 1


def cmd_raw(args):
    try:
        params = json.loads(args.params) if args.params else {}
    except json.JSONDecodeError as e:
        die("--params is not valid JSON: %s" % e)
    tok, sid, _ = connect()
    msg, _ = rpc({"jsonrpc": "2.0", "id": 2, "method": args.method,
                  "params": params}, tok, sid)
    print(json.dumps(msg, indent=2))
    return 0


# ---------------------------------------------------------------------------
# argparse
# ---------------------------------------------------------------------------
def main(argv):
    ap = argparse.ArgumentParser(prog="mobbin", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")

    lp = sub.add_parser("login", help="one-time OAuth (PKCE) approval in the browser")
    lp.add_argument("--port", type=int, default=REDIRECT_PORT,
                    help="localhost callback port (default %d)" % REDIRECT_PORT)
    lp.add_argument("--no-open", action="store_true",
                    help="print the URL instead of opening a browser")

    sub.add_parser("doctor", help="check endpoint reachability + auth + live tool list")

    tp = sub.add_parser("tools", help="list tools the server exposes right now")
    tp.add_argument("--full", action="store_true", help="full input schemas, not the digest")

    cp = sub.add_parser("call", help="call any tool by name (schema-agnostic passthrough)")
    cp.add_argument("tool", help="tool name as shown by `mobbin tools`")
    cp.add_argument("--args", help="JSON object of tool arguments")
    cp.add_argument("--set", action="append", metavar="KEY=VALUE",
                    help="set one argument (repeatable; value parsed as JSON when possible)")
    cp.add_argument("--out", metavar="DIR", help="save inline base64 images into DIR")
    cp.add_argument("--lowres", action="store_true",
                    help="skip the native-resolution fetch, keep only ~300px MCP previews")
    cp.add_argument("--width", type=int, default=1440, help="hires width px (default 1440)")

    rp = sub.add_parser("raw", help="send any JSON-RPC method (escape hatch)")
    rp.add_argument("method", help="e.g. tools/list, resources/list, prompts/list")
    rp.add_argument("--params", help="JSON params object")

    args = ap.parse_args(argv)
    if not args.cmd:
        ap.print_help()
        return 0
    fn = {"login": cmd_login, "doctor": cmd_doctor, "tools": cmd_tools,
          "call": cmd_call, "raw": cmd_raw}[args.cmd]
    return fn(args) or 0


if __name__ == "__main__":
    try:  # die cleanly on SIGPIPE like a normal unix tool (no traceback when piped to head)
        import signal
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (ImportError, AttributeError, ValueError):
        pass
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
